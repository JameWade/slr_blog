---
import { ClientRouter } from "astro:transitions";
import {
  PUBLIC_GOOGLE_SITE_VERIFICATION,
  PUBLIC_BAIDU_SITE_VERIFICATION,
} from "astro:env/client";
import { SITE, metrics } from "@/config";
import "@/styles/global.css";
export interface Props {
  title?: string;
  author?: string;
  profile?: string;
  description?: string;
  ogImage?: string;
  canonicalURL?: string;
  pubDatetime?: Date;
  modDatetime?: Date | null;
  scrollSmooth?: boolean;
  breadcrumbs?: { name: string; url: string }[];
  itemList?: { name: string; url: string }[];
}

const {
  title = SITE.title,
  author = SITE.author,
  profile = SITE.profile,
  description = SITE.desc,
  ogImage = SITE.ogImage ? `/${SITE.ogImage}` : "/og.png",
  canonicalURL = new URL(Astro.url.pathname, Astro.url),
  pubDatetime,
  modDatetime,
  scrollSmooth = false,
  breadcrumbs = [],
  itemList = [],
} = Astro.props;

const socialImageURL = new URL(ogImage, Astro.url);

// WebSite 结构化数据：全站输出，帮助搜索引擎与 AI 理解站点及站内搜索入口
const websiteData = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: SITE.title,
  url: SITE.website,
  inLanguage: SITE.lang,
  description: SITE.desc,
  author: {
    "@type": "Person",
    name: `${author}`,
    ...(profile && { url: profile }),
  },
  potentialAction: {
    "@type": "SearchAction",
    target: `${SITE.website}/search?q={search_term_string}`,
    "query-input": "required name=search_term_string",
  },
};

const graph: Record<string, unknown>[] = [websiteData];

// 仅文章页输出 BlogPosting（此前所有页面都输出，类型不准确）
if (pubDatetime) {
  graph.push({
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    headline: `${title}`,
    image: `${socialImageURL}`,
    datePublished: `${pubDatetime.toISOString()}`,
    ...(modDatetime && { dateModified: modDatetime.toISOString() }),
    author: [
      {
        "@type": "Person",
        name: `${author}`,
        ...(profile && { url: profile }),
      },
    ],
  });
}

if (breadcrumbs.length > 0) {
  graph.push({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: breadcrumbs.map((crumb, index) => ({
      "@type": "ListItem",
      position: index + 1,
      name: crumb.name,
      item: crumb.url,
    })),
  });
}

if (itemList.length > 0) {
  graph.push({
    "@context": "https://schema.org",
    "@type": "ItemList",
    itemListElement: itemList.map((item, index) => ({
      "@type": "ListItem",
      position: index + 1,
      name: item.name,
      url: item.url,
    })),
  });
}

const structuredData =
  graph.length === 1
    ? graph[0]
    : { "@context": "https://schema.org", "@graph": graph };
---

<!doctype html>
<html
  dir={SITE.dir}
  lang=`${SITE.lang ?? "en"}`
  class={`${scrollSmooth && "scroll-smooth"}`}
>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />
    <meta name="generator" content={Astro.generator} />

    <!-- General Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="author" content={author} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Open Graph / Facebook -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={socialImageURL} />

    <!-- Article Published/Modified time -->
    {
      pubDatetime && (
        <meta
          property="article:published_time"
          content={pubDatetime.toISOString()}
        />
      )
    }
    {
      modDatetime && (
        <meta
          property="article:modified_time"
          content={modDatetime.toISOString()}
        />
      )
    }

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={socialImageURL} />

    <!-- JSON-LD Structured data: WebSite (+ BlogPosting / BreadcrumbList / ItemList as applicable) -->
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(structuredData)}
    />

    <!-- Enable RSS feed auto-discovery  -->
    <!-- https://docs.astro.build/en/recipes/rss/#enabling-rss-feed-auto-discovery -->
    <link
      rel="alternate"
      type="application/rss+xml"
      title={SITE.title}
      href={new URL("rss.xml", Astro.site)}
    />

    <meta name="theme-color" content="" />

    {
      // If PUBLIC_GOOGLE_SITE_VERIFICATION is set in the environment variable,
      // include google-site-verification tag in the heading
      // Learn more: https://support.google.com/webmasters/answer/9008080#meta_tag_verification&zippy=%2Chtml-tag
      PUBLIC_GOOGLE_SITE_VERIFICATION && (
        <meta
          name="google-site-verification"
          content={PUBLIC_GOOGLE_SITE_VERIFICATION}
        />
      )
    }

    {
      // 百度站长平台验证：Vercel 配置 PUBLIC_BAIDU_SITE_VERIFICATION 后输出
      // https://ziyuan.baidu.com/site/index
      PUBLIC_BAIDU_SITE_VERIFICATION && (
        <meta
          name="baidu-site-verification"
          content={PUBLIC_BAIDU_SITE_VERIFICATION}
        />
      )
    }

    <ClientRouter />

    <script is:inline src="/toggle-theme.js"></script>

    {metrics.enable && <script is:inline src={metrics.sdk} />}
    <script
      is:inline
      type="module"
      data-astro-rerun
      define:vars={{ metrics: metrics }}
    >
      if (metrics.enable) {
        LA.init({ id: metrics.id, ck: metrics.ck });
      }
    </script>

<!-- KaTeX for math rendering -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.css" integrity="sha384-n8MVd4RsNIU0tAv4ct0nTaAbDJwPJzDEaqSD1odI+WdtXRGWt2kTvGFasHpSy3SV" crossorigin="anonymous" />

<!-- 播放器样式（APlayer 本体） -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/aplayer/dist/APlayer.min.css" />
<script is:inline src="https://cdn.jsdelivr.net/npm/aplayer/dist/APlayer.min.js"></script>

  </head>
  <body>
    <slot />
    <!-- 音乐播放器：APlayer 直读站内静态歌单（不再依赖已失效的 Meting API） -->
    <div id="aplayer"></div>
    <script is:inline data-astro-rerun>
      (function () {
        if (window.__sitePlayer || !window.APlayer) return;
        Promise.all(
          ["/playlist-1.json", "/playlist-2.json"].map(function (u) {
            return fetch(u).then(function (r) { return r.json(); });
          })
        )
          .then(function (parts) {
            var audio = [].concat.apply([], parts);
            if (!audio.length) return;
            var accent = function () {
              return (
                getComputedStyle(document.documentElement).getPropertyValue("--accent").trim() ||
                "#006cac"
              );
            };
            var ap = new APlayer({
              container: document.getElementById("aplayer"),
              fixed: true,
              autoplay: false,
              theme: accent(),
              loop: "all",
              order: "list",
              preload: "none",
              volume: 0.7,
              listMaxHeight: "320px",
              lrcType: 0,
              audio: audio,
            });
            window.__sitePlayer = ap;
            // 跟随深浅主题切换品牌色
            new MutationObserver(function () { ap.theme(accent()); }).observe(
              document.documentElement,
              { attributes: true, attributeFilter: ["data-theme"] }
            );
            // 失效的音频自动跳过（连续失败过多则停下）
            var errCount = 0;
            ap.audio.addEventListener("error", function () {
              errCount += 1;
              if (errCount < 20) ap.skipForward();
            });
            ap.on("play", function () { errCount = 0; });
          })
          .catch(function () {});
      })();
    </script>
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }
</style>
