---
import type { CollectionEntry } from "astro:content";
import IconChevronRight from "@/assets/icons/IconChevronRight.svg";
import dayjs from "dayjs";
import utc from "dayjs/plugin/utc";
import timezone from "dayjs/plugin/timezone";
import { SITE } from "@/config";
import { getPath } from "@/utils/getPath";
import { getReadingTime } from "@/utils/getReadingTime";

export interface Props {
  posts: CollectionEntry<"blog">[];
}

dayjs.extend(utc);
dayjs.extend(timezone);

const { posts } = Astro.props as Props;
---

<section id="posts" class="pt-2">
  <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:gap-4">
    <div class="shrink-0 text-xl font-semibold tracking-wide text-foreground sm:w-[80px]">文章</div>

    <div class="min-w-0 flex-1">
      <ul class="space-y-2">
        {posts.map(post => {
          const minutes = getReadingTime(post.body ?? "");
          const date = dayjs((post.data.modDatetime ?? post.data.pubDatetime) as any)
            .tz(SITE.timezone)
            .format("YYYY/MM/DD");
          return (
            <li>
              <a
                href={getPath(post.id, post.filePath)}
                class="group flex items-center justify-between gap-3 rounded-xl border border-app-border/60 bg-app/30 px-4 py-3 transition-colors hover:bg-app/60"
              >
                <div class="min-w-0 flex-1">
                  <div class="truncate text-[15px] font-medium">{post.data.title}</div>
                  <div class="mt-1 flex flex-wrap items-center gap-x-2 gap-y-1 text-xs text-app-dim">
                    <span class="whitespace-nowrap rounded-full border border-app-border/60 bg-app/40 px-2 py-0.5 text-[10px]">
                      {date}
                    </span>
                    <span class="whitespace-nowrap">约 {minutes} 分钟</span>
                    <span class="flex flex-wrap items-center gap-x-1.5 gap-y-1 sm:ms-auto">
                      {post.data.tags.slice(0, 3).map(tag => (
                        <span class="whitespace-nowrap rounded-full border border-accent/30 px-2 py-px text-[10px] text-accent">
                          #{tag}
                        </span>
                      ))}
                    </span>
                  </div>
                  {post.data.description && (
                    <p class="mt-1 truncate text-sm text-app-dim">{post.data.description}</p>
                  )}
                </div>
                <span class="ms-3 grid size-6 shrink-0 place-items-center rounded-full border border-app-border/60 bg-app/40">
                  <IconChevronRight class="shrink-0 stroke-2 transition-transform group-hover:translate-x-0.5 rtl:-rotate-180" />
                </span>
              </a>
            </li>
          );
        })}
      </ul>
    </div>
  </div>
</section>
